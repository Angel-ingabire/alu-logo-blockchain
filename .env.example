# Copy this file to .env and fill in values for a local deployment only.
# Never commit a real private key, secret, or production credential.

SEPOLIA_RPC_URL=https://sepolia.example-rpc-url.com
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here
EXPECTED_OWNER_ADDRESS=0xYOUR_EXPECTED_OWNER_ADDRESS

# Frontend network selection: local or sepolia
VITE_NETWORK=local

# Local Hardhat deployment addresses (used when VITE_NETWORK=local)
VITE_ALU_ASSET_REGISTRY=0x0000000000000000000000000000000000000000
VITE_ALU_LOGO_TOKEN=0x0000000000000000000000000000000000000000

# Sepolia deployment addresses (fill in only after deployment approval)
VITE_SEPOLIA_ALU_ASSET_REGISTRY=0x0000000000000000000000000000000000000000
VITE_SEPOLIA_ALU_LOGO_TOKEN=0x0000000000000000000000000000000000000000
VITE_SEPOLIA_RPC_URL=https://sepolia.example-rpc-url.com
