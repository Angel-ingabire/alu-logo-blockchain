# Copy this file to the repository root as .env only when deploying to Sepolia.
# Never commit a real private key, secret, or production credential.

SEPOLIA_RPC_URL=https://sepolia.example-rpc-url.com
SEPOLIA_PRIVATE_KEY=your_sepolia_private_key_here
EXPECTED_OWNER_ADDRESS=0xYOUR_EXPECTED_OWNER_ADDRESS
